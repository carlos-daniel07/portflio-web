---
import "../styles/global.css";
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
import "@fontsource/inter/latin-400.css";
import "@fontsource/inter/latin-600.css";
import "@fontsource/montserrat/latin-900.css";

const schema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Carlos Arteaga",
  jobTitle: "Desarrollador Web Full Stack",
  description:
    "Desarrollador web full stack. Creo interfaces rápidas y escalables con React, Astro, Tailwind CSS, Node.js y bases de datos.",
  url: "https://carlosarteaga.dev/",
  image:
    "https://res.cloudinary.com/dwdyg6evh/image/upload/v1791307686/carlos-arteaga-desarrollador-web-full-stack_qgr782.jpg",
  knowsAbout: [
    "Desarrollo web",
    "React",
    "Astro",
    "Tailwind CSS",
    "Node.js",
    "JavaScript",
    "Bases de datos",
  ],
  sameAs: [
    "https://github.com/carlos-daniel07",
    "https://www.linkedin.com/in/carlos-daniel-arteaga/",
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Carlos Arteaga | Desarrollador Web Full Stack</title>
    <meta
      name="description"
      content="Portafolio de Carlos Arteaga, desarrollador web full stack. Creo interfaces rápidas y escalables con React, Astro, Tailwind CSS, Node.js y bases de datos. Mira mis proyectos."
    />
    <meta name="author" content="Carlos Arteaga" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonicalURL} />
    <meta
      name="google-site-verification"
      content="esysvBWp-i2Up4x4ZMnRZOUeqMAnzEkVtzGYkksRq-c"
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(schema)}
    />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph (Facebook, WhatsApp, LinkedIn, Discord) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Carlos Arteaga" />
    <meta property="og:locale" content="es_LA" />
    <meta property="og:url" content="https://carlosarteaga.dev/" />
    <meta
      property="og:title"
      content="Carlos Arteaga | Desarrollador Web Full Stack"
    />
    <meta
      property="og:description"
      content="Portafolio de Carlos Arteaga, desarrollador web full stack. Creo interfaces rápidas y escalables con React, Astro, Tailwind CSS y Node.js. Mira mis proyectos."
    />
    <meta
      property="og:image"
      content="https://res.cloudinary.com/dwdyg6evh/image/upload/v1791307686/carlos-arteaga-desarrollador-web-full-stack_qgr782.jpg"
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Portafolio de Carlos Arteaga, desarrollador web full stack"
    />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:title"
      content="Carlos Arteaga | Desarrollador Web Full Stack"
    />
    <meta
      name="twitter:description"
      content="Portafolio de Carlos Arteaga, desarrollador web full stack. Creo interfaces rápidas y escalables con React, Astro, Tailwind CSS y Node.js. Mira mis proyectos."
    />
    <meta
      name="twitter:image"
      content="https://res.cloudinary.com/dwdyg6evh/image/upload/v1791307686/carlos-arteaga-desarrollador-web-full-stack_qgr782.jpg"
    />
    <meta
      name="twitter:image:alt"
      content="Portafolio de Carlos Arteaga, desarrollador web full stack"
    />
    <!-- Favicon -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>

  <body class="bg-[#0a0a0a] text-gray-100 antialiased overflow-x-hidden">
    <slot />
  </body>
</html>
