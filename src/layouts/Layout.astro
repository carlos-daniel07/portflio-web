---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Portafolio de Desarrollador Web y de Software" } =
  Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <title>Carlos Arteaga | Desarrollador Web</title>
    <meta name="title" content="Carlos Arteaga | Desarrollador Web" />
    <meta
      name="title"
      content="Carlos Arteaga | Desarrollador Web Full Stack"
    />
    <meta name="title" content="Carlos Arteaga | Web Developer" />
    <meta name="title" content="Carlos Arteaga | Frontend Developer" />
    <meta name="title" content="Carlos Arteaga | Backend Developer" />
    <meta
      name="description"
      content="Portafolio profesional de Carlos Arteaga. Desarrollador web especializado en crear interfaces modernas, rápidas y escalables con React, Astro y Tailwind CSS, Node.js y bases de datos. Explora mis proyectos, experiencia y habilidades en desarrollo web."
    />
    <meta name="author" content="Carlos Arteaga" />
    <meta
      name="keywords"
      content="Frontend Developer, Backend Developer, Desarrollador Web, React, Astro, JavaScript, HTML, CSS, Portafolio, Tailwind CSS, Node.js, Bases de Datos, Experiencia, Habilidades, Proyectos, Desarrollo Web, Interfaces Modernas, Escalables, Rápidas, Full Stack DEveloper. Desarrollador FullcStack"
    />
    <meta name="theme-color" content="#0a0a0a" />
    <meta property="og:type" content="website" />
    <meta
      property="og:url"
      content="https://https://carlosarteaga.netlify.app/"
    />
    <meta property="og:title" content="Carlos Arteaga | Desarrollador Web" />
    <meta
      property="og:description"
      content="Descubre mis proyectos, experimentos y código. Trabajo con React, Tailwind, Vanilla JS, Node.js y bases de datos."
    />
    <meta
      property="og:image"
      content="https://res.cloudinary.com/dwdyg6evh/image/upload/v1790894331/carlos-arteaga-og_gfgipn.webp"
    />

    <meta property="twitter:card" content="summary_large_image" />
    <meta
      property="twitter:url"
      content="https://https://carlosarteaga.netlify.app/"
    />
    <meta
      property="twitter:title"
      content="Carlos Arteaga | Desarrollador Web"
    />
    <meta
      property="twitter:description"
      content="Descubre mis proyectos, experimentos y código. Trabajo con React, Tailwind, Vanilla JS, Node.js y bases de datos."
    />
    <meta
      property="twitter:image"
      content="https://res.cloudinary.com/dwdyg6evh/image/upload/v1790894331/carlos-arteaga-og_gfgipn.webp"
    />

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- AQUÍ AGREGAMOS LAS FUENTES -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=Montserrat:wght@900&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="bg-[#0a0a0a] text-gray-100 antialiased overflow-x-hidden">
    <slot />
  </body>
</html>
